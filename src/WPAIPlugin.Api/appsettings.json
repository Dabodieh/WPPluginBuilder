{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Planning": {
    "DefaultProvider": "openai",
    "Anthropic": {
      "ApiKey": "",
      "Model": "claude-sonnet-5",
      "BaseUrl": "https://api.anthropic.com"
    },
    "OpenAI": {
      "ApiKey": "",
      "Model": "gpt-5.6-luna",
      "BaseUrl": "https://api.openai.com"
    }
  },
  "Validation": {
    "Enabled": true,
    "TimeoutSeconds": 120
  },
  "Artifacts": {
    "RootPath": "App_Data/artifacts"
  },
  "Credits": {
    "SignupGrant": 100,
    "StandardBuildCost": 1,
    "ValidatedBuildCost": 2
  }
}
