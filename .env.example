# Copy to .env and fill in real values. .env is gitignored - never commit
# real secrets. Used by docker/docker-compose.prod.example.yml; the same
# names also work as environment variables for a non-Docker deployment
# (ASP.NET Core's configuration binds double-underscore names to nested
# config sections, e.g. ConnectionStrings__DefaultConnection).

# --- Required in production ---

# Non-Development environments enforce the startup checks below (see
# Program.cs) and enable Secure cookies/HSTS/generic error responses. The
# Dockerfile and compose example already set this; a non-Docker deployment
# must set it explicitly.
ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL. Either set the individual pieces below (used by the compose
# example to build the connection string) or set the full connection
# string directly via ConnectionStrings__DefaultConnection.
POSTGRES_DB=wpaiplugin
POSTGRES_USER=wpaiplugin
POSTGRES_PASSWORD=

# Exactly one provider is required, matching PLANNING_DEFAULT_PROVIDER.
PLANNING_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Account recovery (ModuleMint branding + account-recovery milestone) -
# required in production alongside the above. PublicBaseUrl is the only
# trusted source for building a password-reset URL - never a browser-
# supplied Host header. The same Support email is used for general support,
# privacy enquiries, billing questions, refund requests, and account-access
# help. Resend delivers the password-reset email; never commit a real key.
App__PublicBaseUrl=https://example.com
Support__Email=support@example.com
Email__FromAddress=no-reply@example.com
Email__FromName=ModuleMint
Resend__ApiKey=

# --- Optional / has safe defaults ---

# Config-driven admin bootstrap (see README "Admin bootstrap" for the full
# operator runbook). Blank by default - nothing is granted admin until this
# is set to a real, already-registered account's email.
# ADMIN__BOOTSTRAPEMAIL=

# Reverse-proxy trust (see README "Reverse proxy / HTTPS"). Leave empty to
# trust nothing from outside the container (safe default; forwarded
# scheme/host/IP are ignored, matching direct-Kestrel behavior).
TRUSTED_PROXY_IP=

# Host port the app container's 8080 is published on. Change only if 8080
# is already used by something else on this host.
# APP_PORT=8080

# Credits__SignupGrant=5
# Credits__StandardBuildCost=1
# Credits__ValidatedBuildCost=2
# Credits__MaxAdminAdjustmentMagnitude=10000

# Free-build entitlements granted to every new registration, distinct from
# signup credits above (see README "New-customer free builds").
# Promotions__SignupFreeBuilds=2

# Stripe credit purchases - optional; checkout returns 503 until set.
# Never commit real values. Webhook secret comes from your Stripe Dashboard
# webhook endpoint (or `stripe listen`/`stripe trigger` for local testing).
# STRIPE__SECRETKEY=
# STRIPE__WEBHOOKSECRET=
# STRIPE__PUBLICBASEURL=https://your-app-domain

# Credit pack catalog (GBP, integer pence) - already has the configured
# defaults in appsettings.json; override here only to change them.
# CREDITPACKS__PACKS__STARTER__CREDITS=25
# CREDITPACKS__PACKS__STARTER__AMOUNTMINOR=499

# Security__PlanningPerMinute=10
# Security__PlanningPerHour=10
# Security__PlanningPerDay=20
# Security__BuildsPerMinute=6
# Security__ValidatedBuildsPerMinute=2
# Security__AccountRequestsPerFiveMinutes=10
# Security__CheckoutPerMinute=6
# Security__PromoCodePerMinute=10
# Security__PasswordRecoveryPerFiveMinutes=5
# Security__EmailVerificationResendPerFiveMinutes=3

# Internal AI-spend safety net (not customer-facing) - generous by default so
# a legitimate user never notices it; only bounds worst-case cost from one
# abusive/compromised account. Micro-dollars: 1,000,000 = $1.00.
# Abuse__MaxAiCostUsdMicrosPerUserPerDay=5000000

# Validation__Enabled=true
# Validation__TimeoutSeconds=120

# Artifacts__RootPath=/app/App_Data/artifacts
# DataProtection__KeyRingPath=/app/App_Data/dataprotection-keys
