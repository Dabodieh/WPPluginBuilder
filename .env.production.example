# Production environment for the Plesk + Docker deployment
# (docker/docker-compose.production.yml). Copy this file to
# .env.production on the server, fill in real values, and never commit it -
# .env.production is gitignored. This is a TEMPLATE only; every value below
# is a placeholder.
#
# Usage:
#   docker compose --env-file .env.production -f docker/docker-compose.production.yml -p modulemint up -d --build
#
# See docs/DEPLOYMENT.md "Plesk + Docker Deployment" for the full runbook.

ASPNETCORE_ENVIRONMENT=Production

# --- Domain ---
APP_PUBLIC_BASE_URL=https://modulemint.co.uk

# --- PostgreSQL (internal to the compose network only - never exposed) ---
POSTGRES_DB=modulemint
POSTGRES_USER=modulemint
POSTGRES_PASSWORD=CHANGE_ME

# --- AI provider (OpenAI is primary) ---
OPENAI_API_KEY=CHANGE_ME

# --- Transactional email (Resend) ---
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM_ADDRESS=no-reply@modulemint.co.uk
EMAIL_FROM_NAME=ModuleMint
SUPPORT_EMAIL=support@modulemint.co.uk

# --- Cloudflare Turnstile (registration signup-farming hardening) ---
# Required: production refuses to start without both. Create a Turnstile
# site at https://dash.cloudflare.com/?to=/:account/turnstile for your real
# domain - TURNSTILE_SITE_KEY is public (safe in page JS), TURNSTILE_SECRET_KEY
# is server-only and must never be committed or logged.
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME

# --- Initial production launch: Docker-based plugin validation is off.
# Standard "Build Plugin" is unaffected; only "Build & Validate" is
# unavailable, since it would otherwise need the host Docker socket mounted
# into the web container (deliberately not done - see docs/DEPLOYMENT.md).
VALIDATION_ENABLED=false

# --- Optional: promote this email to Admin on first startup after it
# registers through the normal /register.html flow (see docs/DEPLOYMENT.md
# "Admin bootstrap"). Leave blank until you know which account this is.
ADMIN_BOOTSTRAP_EMAIL=
